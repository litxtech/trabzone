    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "build:web": "expo export --platform web --clear && node scripts/generate-seo.mjs",
    "seo": "node scripts/generate-seo.mjs",
    "db:apply": "node scripts/db-apply.mjs",
    "db:check": "node scripts/db-check.mjs",
    "demo:photos": "node scripts/fetch-demo-photos.mjs",
    "demo:seed": "node scripts/demo-seed.mjs",
    "verify:rpcs": "node scripts/verify-rpcs.mjs",
    "smoke:social": "node scripts/smoke-social.mjs",
    "smoke:ride": "node scripts/db-run-sql.mjs scripts/ride-e2e-smoke.sql",
    "smoke:safety": "node scripts/smoke-safety.mjs",
    "smoke:deletion": "node scripts/smoke-deletion.mjs",
    "admin:grant": "node scripts/grant-admin.mjs",
