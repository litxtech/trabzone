{
  "name": "trabzone",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --dev-client --lan --clear",
    "dev:tunnel": "expo start --dev-client --tunnel --clear",
