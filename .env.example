# Copy to .env and fill in. Only EXPO_PUBLIC_* values reach the app bundle.

# --- Supabase ---------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- App --------------------------------------------------------------------
EXPO_PUBLIC_APP_URL=https://trabzone.app
EXPO_PUBLIC_LIVEKIT_URL=
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
EXPO_PUBLIC_ENABLE_SOCIAL_AUTH=false

# --- Server-side only (CLI / Edge Functions) --------------------------------
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# --- LiveKit ----------------------------------------------------------------
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Cloudflare R2 ----------------------------------------------------------
R2_ACCOUNT_ID=
R2_BUCKET_NAME=trabzone-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=

# --- Stripe / Push / Stream (later phases) ----------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
CLOUDFLARE_STREAM_TOKEN=
EXPO_PROJECT_ID=
