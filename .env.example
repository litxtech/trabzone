# Copy to .env and fill in. Only EXPO_PUBLIC_* values reach the app bundle.

# --- Supabase ---------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- App --------------------------------------------------------------------
EXPO_PUBLIC_APP_URL=https://www.trabzoneapp.com
EXPO_PUBLIC_LIVEKIT_URL=
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
EXPO_PUBLIC_ENABLE_SOCIAL_AUTH=false

# --- Apple ve Google ile giriş ---------------------------------------------
# `EXPO_PUBLIC_ENABLE_SOCIAL_AUTH=true` yapıldığında:
# - Apple: iOS native oturumu açılır. Supabase > Authentication > Providers >
#   Apple etkin olmalı ve client ID uygulamanın bundle ID'si olmalı
#   (com.litxtech.trabzone). Apple Developer'da App ID için "Sign In with
#   Apple" yetkisi açık, provisioning profile yenilenmiş olmalıdır.
# - Google: native hesap seçici için aşağıdaki istemci kimlikleri gerekir.
#   WEB kimliği Supabase Google sağlayıcısına yazılır (id token `aud` kontrolü)
#   ve Android tarafında da kullanılır. IOS kimliği iOS istemcisidir. Boş
#   bırakılırsa Google butonu gizlenir.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Native Google hesap secicisi. Varsayilan (false) tarayici tabanli PKCE akisi:
# Android'de imza parmak izine bagli OAuth istemcisi, iOS'ta ayri istemci
# kimligi gerekmez ve id token nonce dogrulamasi devreye girmez. Native akis
# icin Google Cloud'da platform istemcileri olusturulmali, Supabase Google
# saglayicisina istemci kimlikleri eklenmeli ve "Skip nonce check" acilmalidir.
EXPO_PUBLIC_GOOGLE_NATIVE_LOGIN=false
# Cloudflare R2 public taban adresi (örn. https://media.trabzoneapp.com).
# Tanımlıysa bütün medya R2'ye yüklenir; herkese açık kovalar bu adresten
# sunulur, gizli sohbet medyası private bucket'ta kalıp imzalı GET ile okunur.
# Zorunludur: boş bırakılırsa medya yüklemesi hata verir.
# Derleme anında gömülür: EAS profillerinde (eas.json) de tanımlanmalı.
EXPO_PUBLIC_R2_PUBLIC_URL=

# --- Firebase (Android FCM) -------------------------------------------------
# Firebase konsolundan indirilen google-services.json. Android'de push token
# alınabilmesi için derlemeye girmesi zorunludur; depoya eklenmez.
# Yerelde ./assets/google-services.json yolunu gösterir.
# EAS build'de aynı adla bir *dosya tipi* ortam değişkeni tanımlanmalıdır:
#   npx eas-cli env:create --name GOOGLE_SERVICES_JSON --type file \
#     --value ./assets/google-services.json --environment production --visibility secret
GOOGLE_SERVICES_JSON=./assets/google-services.json

# --- Server-side only (CLI / Edge Functions) --------------------------------
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
# Yalnızca sunucuda kullanılır; istemciye asla verilmez.
SUPABASE_SERVICE_ROLE_KEY=

# --- Transactional e-posta (Resend) ----------------------------------------
# Sunucu tarafı worker: npm run email:worker
RESEND_API_KEY=
EMAIL_FROM=Trabzone <destek@trabzoneapp.com>

# --- LiveKit ----------------------------------------------------------------
# livekit-token edge function bu değerlerle erişim anahtarı imzalar.
LIVEKIT_URL=wss://trabzone-pvll6x7f.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Cloudflare R2 ----------------------------------------------------------
# Cloudflare Dashboard > R2 > sağ üstteki Account ID (32 karakter).
# r2-sign edge function S3 endpoint'ini bu değerden üretir; boşsa imzalı URL verilemez.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=trabzone-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=

# --- Sign in with Apple (jeton iptali) --------------------------------------
# Apple App Store 5.1.1(v): hesap silindiğinde uygulamanın Apple yetkisi de
# kaldırılmalı. `apple-token` edge function Apple yetki kodunu yenileme jetonuna
# çevirir ve hesap silmede Apple'ın /auth/revoke ucuna gönderir.
# Apple Developer > Certificates, Identifiers & Profiles > Keys bölümünden
# "Sign in with Apple" anahtarı oluşturulur; .p8 dosyası yalnızca bir kez indirilir.
#   supabase secrets set APPLE_TEAM_ID=... APPLE_KEY_ID=... APPLE_PRIVATE_KEY="$(cat AuthKey_XXXX.p8)"
# Boş bırakılırsa jeton iptali sessizce atlanır (giriş ve silme çalışmaya devam eder).
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Services ID (web akışı için). Supabase Apple sağlayıcısındaki Client IDs
# alanı "<services-id>,<bundle-id>" sırasıyla yazılır: web akışı ilk kimliği
# kullanır, iOS native kimlik anahtarının `aud` değeri ikinci sırada eşleşir.
APPLE_CLIENT_ID=
# `.p8` dosyasının yerel yolu (yalnızca `npm run apple:secret` için; depoya
# konmaz, derlemeye girmez).
APPLE_KEY_FILE=
# Supabase'e yazılacak tam istemci listesi (Services ID ilk sırada).
APPLE_CLIENT_IDS=

# --- Apple ile giriş: Android (web OAuth) -----------------------------------
# iOS'ta native akış için bundle ID yeterlidir. Apple, Android için native bir
# SDK sunmadığı için uygulama Apple'ın web yetkilendirmesini (PKCE) kullanır.
# Etkinleştirmek için (ek derleme gerekmez):
#   1. Apple Developer > Identifiers > Services IDs: com.litxtech.trabzone.web
#      - "Sign in with Apple" açılır; Return URL:
#        https://<proje-ref>.supabase.co/auth/v1/callback
#   2. Apple Developer > Keys: "Sign in with Apple" anahtarı (.p8) oluşturulur.
#   3. Supabase > Authentication > Providers > Apple:
#      - Client IDs: com.litxtech.trabzone.web,com.litxtech.trabzone
#        (Services ID İLK sırada olmalı: web akışı ilk kimliği kullanır,
#         native iOS kimlik anahtarının `aud` değeri ikinci sırada eşleşir.)
#      - Secret: .p8 anahtarıyla üretilen istemci sırrı (6 ayda bir yenilenir).
#   4. Jeton iptali için aşağıdaki APPLE_* değerleri edge function sırrı olarak
#      eklenir: supabase secrets set APPLE_TEAM_ID=... APPLE_KEY_ID=...
#      APPLE_PRIVATE_KEY="$(cat AuthKey_XXXXXX.p8)"
#
# İstemci sırrını üretmek / 6 ayda bir yenilemek için:
#   npm run apple:secret -- --key-file ./AuthKey_XXXXXXXXXX.p8 --push
# Script önce Apple'ın token ucunda imzayı doğrular (invalid_client =
# anahtar/kimlik eşleşmiyor), sonra --push ile Supabase'i günceller.

# --- Stripe / Push / Stream (later phases) ----------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
CLOUDFLARE_STREAM_TOKEN=
EXPO_PROJECT_ID=

# --- Google Search Console ---------------------------------------------------
# Search Console > Settings > Ownership verification > HTML tag yontemindeki
# token. generate-seo.mjs bu degeri her HTML sayfasinin <head> bolumune
# <meta name="google-site-verification" content="..."> olarak ekler.
# Ayni token DNS tarafinda TXT kaydi olarak da tutulmalidir:
#   trabzoneapp.com  TXT  google-site-verification=<token>
#   www.trabzoneapp.com  TXT  google-site-verification=<token>
GOOGLE_SITE_VERIFICATION=

# --- Harici işletme araması (Google + Apple haritaları) ----------------------
# "Haritaya yer ekle" formundaki öneri araması /api/place-search üzerinden
# çalışır. Anahtarlar yalnızca sunucuda (Vercel > Environment Variables)
# tanımlanır; istemci paketine girmez.
#
# Google: Google Cloud Console > APIs & Services > "Places API (New)" etkin
# olmalı. Anahtarı yalnızca bu API ile sınırlayın.
# Aynı anahtar /api/place-photo ucunu da besler: Trabzone'da kapak fotoğrafı
# olmayan işletmelerin kartlarında Google Haritalar fotoğrafı gösterilir
# (Apple Maps sunucu API'si fotoğraf vermez). Her eşleşme Text Search +
# Place Photo çağrısıdır; Google Cloud'da bütçe uyarısı/kota tanımlayın.
GOOGLE_MAPS_API_KEY=
#
# Apple: Apple Developer > Certificates, Identifiers & Profiles > Keys >
# "MapKit JS" anahtarı (.p8, yalnızca bir kez indirilir) ve Team ID.
# Çok satırlı .p8 içeriği tek satırda `\n` kaçışıyla yazılabilir.
APPLE_MAPKIT_TEAM_ID=
APPLE_MAPKIT_KEY_ID=
APPLE_MAPKIT_PRIVATE_KEY=
#
# İsteğe bağlı: farklı bir ortamda çalışırken arama uç noktasını değiştirir.
# Boşsa EXPO_PUBLIC_APP_URL/api/place-search kullanılır.
EXPO_PUBLIC_PLACE_SEARCH_URL=

# --- Paylaşım bağlantıları (deep link) ---------------------------------------
# Paylaşılan https bağlantılarının doğrudan uygulamada açılması (iOS universal
# links / Android App Links) native derlemede gerekir. iOS'ta "Associated
# Domains" yetkisi App ID'de açılmadan bu bayrağı açmayın; aksi halde arşiv
# imzalanamaz. Bayrak kapalıyken de paylaşım çalışır: paylaşım sayfası
# trabzone:// şemasını dener ve uygulama yüklüyse içeriği açar.
EXPO_PUBLIC_ENABLE_UNIVERSAL_LINKS=false
# Android App Links doğrulaması için imza sertifikasının SHA-256 parmak izi.
# Birden fazla sertifika virgülle yazılır. Boşsa assetlinks.json boş dizi döner
# ve Android bağlantıları tarayıcıda açar (trabzone:// denemesi devrede kalır).
ANDROID_CERT_SHA256=

# --- LiteAPI / Nuitee Connect (sunucu tarafı) -----------------------------------
# Yalnızca sunucuda kullanılır; EXPO_PUBLIC_ öneki verilmez.
LITEAPI_API_KEY=
# Varsayılanlar: content https://api.liteapi.travel/v3.0, booking https://book.liteapi.travel/v3.0
LITEAPI_CONTENT_BASE_URL=
LITEAPI_BOOKING_BASE_URL=
LITEAPI_TIMEOUT_MS=20000
LITEAPI_REQUESTS_PER_SECOND=4
LITEAPI_RATE_CACHE_SECONDS=300
LITEAPI_SYNC_DETAIL=true
LITEAPI_RADIUS_SCAN=true
LITEAPI_CURRENCY=TRY
LITEAPI_GUEST_NATIONALITY=TR
# Güvenlik: canlı POST /rates/book varsayılan olarak kapalıdır. İki bayrak
# birlikte true olmadan ve acc_provider_settings.booking_enabled açılmadan
# rezervasyon çağrısı yapılmaz.
LITEAPI_BOOKING_ENABLED=false
LITEAPI_BOOKING_OWNER_APPROVED=false

# iOS'ta Apple girisinin native (tarayicisiz) akisi. Kapaliyken tarayici PKCE
# akisi kullanilir ve derleme 'Sign in with Apple' yetkisi gerektirmez.
# Acmak icin App ID'de capability + yenilenmis profile gerekir.
EXPO_PUBLIC_ENABLE_APPLE_NATIVE_LOGIN=false
