# Copy to .env and fill in. Only EXPO_PUBLIC_* values reach the app bundle.

# --- Supabase ---------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- App --------------------------------------------------------------------
EXPO_PUBLIC_APP_URL=https://www.trabzoneapp.com
EXPO_PUBLIC_LIVEKIT_URL=
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
EXPO_PUBLIC_ENABLE_SOCIAL_AUTH=false
# Yalnızca gizli sohbet medyası (Supabase Storage) için tek dosya sınırı (MB).
# Herkese açık medya R2'ye sınırsız gider; bu değer onları etkilemez.
# Supabase Free planda 50; plan yükseltilince artırılabilir.
EXPO_PUBLIC_MAX_UPLOAD_MB=50
# Cloudflare R2 public taban adresi (örn. https://media.trabzoneapp.com).
# Tanımlıysa herkese açık kovalardaki bütün fotoğraf ve videolar R2'ye yüklenir.
# Zorunludur: boş bırakılırsa medya yüklemesi Supabase'e düşmez, hata verir.
# Örnek: https://pub-xxxxxxxx.r2.dev veya https://media.trabzoneapp.com
# Derleme anında gömülür: EAS profillerinde (eas.json) de tanımlanmalı.
EXPO_PUBLIC_R2_PUBLIC_URL=

# --- Server-side only (CLI / Edge Functions) --------------------------------
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# --- LiveKit ----------------------------------------------------------------
# livekit-token edge function bu değerlerle erişim anahtarı imzalar.
LIVEKIT_URL=wss://trabzone-pvll6x7f.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Cloudflare R2 ----------------------------------------------------------
# Cloudflare Dashboard > R2 > sağ üstteki Account ID (32 karakter).
# r2-sign edge function S3 endpoint'ini bu değerden üretir; boşsa imzalı URL verilemez.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=trabzone-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=

# --- Stripe / Push / Stream (later phases) ----------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
CLOUDFLARE_STREAM_TOKEN=
EXPO_PROJECT_ID=
