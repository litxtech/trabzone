{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "installCommand": "npm install --legacy-peer-deps",
  "functions": {
    "api/listing.js": {
      "includeFiles": "dist/index.html",
      "memory": 1024,
      "maxDuration": 15
    },
    "api/hub.js": {
      "includeFiles": "dist/index.html",
      "memory": 1024,
      "maxDuration": 15
    },
    "api/blog.js": {
      "includeFiles": "dist/index.html",
      "memory": 1024,
      "maxDuration": 15
    },
    "api/share.js": {
      "memory": 512,
      "maxDuration": 10
    },
    "api/news.js": {
      "includeFiles": "dist/index.html",
      "memory": 1024,
      "maxDuration": 15
    },
    "api/sitemap-news.js": {
      "memory": 512,
      "maxDuration": 15
    },
    "api/sitemap-blog.js": {
      "memory": 512,
      "maxDuration": 15
    },
    "api/sitemap-hubs.js": {
      "memory": 512,
      "maxDuration": 15
    },
    "api/sitemap-news.js": {
      "memory": 512,
      "maxDuration": 15
    }
  },
  "redirects": [
    { "source": "/policy/terms", "destination": "/terms", "permanent": true },
    { "source": "/policy/privacy", "destination": "/privacy", "permanent": true },
    { "source": "/real-estate", "destination": "/marketplace/real-estate", "permanent": true },
    { "source": "/businesses", "destination": "/marketplace/places", "permanent": true },
    { "source": "/news/:slug", "destination": "/haber/:slug", "permanent": true }
  ],
  "rewrites": [
    { "source": "/about", "destination": "/seo/about.html" },
    { "source": "/contact", "destination": "/seo/contact.html" },
    { "source": "/support", "destination": "/seo/support.html" },
    { "source": "/terms", "destination": "/seo/terms.html" },
    { "source": "/privacy", "destination": "/seo/privacy.html" },
    { "source": "/kvkk", "destination": "/seo/kvkk.html" },
    { "source": "/data-protection", "destination": "/seo/data-protection.html" },
    { "source": "/cookies", "destination": "/seo/cookies.html" },
    { "source": "/child-safety", "destination": "/seo/child-safety.html" },
    { "source": "/community-guidelines", "destination": "/seo/community-guidelines.html" },
    { "source": "/delete-account", "destination": "/seo/delete-account.html" },
    { "source": "/data-requests", "destination": "/seo/data-requests.html" },
    { "source": "/policy/marketplace-rules", "destination": "/seo/marketplace-rules.html" },
    { "source": "/policy/real-estate-rules", "destination": "/seo/real-estate-rules.html" },
    { "source": "/policy/vehicle-rules", "destination": "/seo/vehicle-rules.html" },

    { "source": "/sitemap-listings.xml", "destination": "/api/sitemap-listings" },
    { "source": "/sitemap-hubs.xml", "destination": "/api/sitemap-hubs" },
    { "source": "/sitemap-blog.xml", "destination": "/api/sitemap-blog" },
    { "source": "/sitemap-news.xml", "destination": "/api/sitemap-news" },

    { "source": "/haber/:slug", "destination": "/api/news?slug=:slug" },
    { "source": "/haber", "destination": "/api/news" },
    { "source": "/sitemap-news.xml", "destination": "/api/sitemap-news" },

    { "source": "/blog/:slug", "destination": "/api/blog?slug=:slug" },
    { "source": "/blog", "destination": "/api/blog" },

    { "source": "/p/:type/:key", "destination": "/api/share?type=:type&key=:key" },

    { "source": "/trabzon/:p1/:p2/:p3", "destination": "/api/hub?p1=:p1&p2=:p2&p3=:p3" },
    { "source": "/trabzon/:p1/:p2", "destination": "/api/hub?p1=:p1&p2=:p2" },
    { "source": "/trabzon/:p1", "destination": "/api/hub?p1=:p1" },
    { "source": "/trabzon", "destination": "/api/hub" },

    { "source": "/marketplace/real-estate/create", "destination": "/index.html" },
    { "source": "/marketplace/real-estate/my-listings", "destination": "/index.html" },
    { "source": "/marketplace/real-estate", "destination": "/index.html" },
    { "source": "/marketplace/cart", "destination": "/index.html" },
    { "source": "/marketplace/catalog", "destination": "/index.html" },
    { "source": "/marketplace/categories", "destination": "/index.html" },
    { "source": "/marketplace/create", "destination": "/index.html" },
    { "source": "/marketplace/map", "destination": "/index.html" },
    { "source": "/marketplace/my-listings", "destination": "/index.html" },
    { "source": "/marketplace/orders", "destination": "/index.html" },
    { "source": "/marketplace/places", "destination": "/index.html" },
    { "source": "/marketplace/saved-searches", "destination": "/index.html" },
    { "source": "/marketplace/search", "destination": "/index.html" },

    { "source": "/marketplace/real-estate/:id", "destination": "/api/listing?kind=real_estate&id=:id" },
    { "source": "/marketplace/:id", "destination": "/api/listing?kind=market&id=:id" },

    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/_expo/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/og-image.png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/favicon-32.png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/favicon-192.png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/apple-touch-icon.png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/icon-512.png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/site.webmanifest",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/admin/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/settings/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/chat/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/call/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/support/my-requests",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/legal/consent",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/feed",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/reels",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/discover",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/messages",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/notifications",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/profile/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/login",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/register",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/forgot-password",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/verify",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/complete-profile",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/compose/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/p/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    },
    {
      "source": "/.well-known/(.*)",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
